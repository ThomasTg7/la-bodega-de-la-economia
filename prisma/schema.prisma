generator client {
  provider = "prisma-client-js"
}

// MariaDB. El provider se declara "mysql" y no "mariadb": hablan el mismo
// protocolo y el conector de Prisma es el mismo, así que el literal correcto
// es ese. El DATABASE_URL también va con prefijo mysql://.
//
// Los @db.VarChar repartidos por el schema no son decorativos: en MySQL y
// MariaDB un String sin largo explícito es varchar(191), donde no entra ni el
// eslogan ni ninguno de los campos que guardan JSON. Dejarlos como TEXT
// tampoco sirve, porque MySQL no admite DEFAULT en columnas TEXT y casi todas
// las nuestras tienen uno.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Producto {
  id          String @id @default(cuid())
  nombre      String
  slug        String @unique
  descripcion String @default("") @db.VarChar(400)
  emoji       String @default("")
  unidad      String @default("kg") // kg | unidad | malla

  // Precios en CLP enteros. null = "no se vende en ese formato" -> no se muestra.
  //
  // Todo lo que sale de la bodega es precio por mayor: `precioBase` es el
  // precio por kilo de siempre y `precioDescuento` el que se aplica al pasar
  // `kilosDescuento`. Los @map conservan los nombres viejos de las columnas
  // (precioDetalle / precioMayorista / umbralMayorista), así que renombrar
  // acá no toca la base ni pide migración.
  precioBase      Int? @map("precioDetalle")
  precioDescuento Int? @map("precioMayorista")
  precioCaja      Int?
  precioBin       Int?

  kilosPorCaja   Int?
  kilosPorBin    Int?

  /// Kilos desde donde se aplica `precioDescuento`. Nullable, y sin default:
  /// vacio significa "este producto no tiene descuento por volumen", igual
  /// que un precio vacio significa "no lo vendo asi". Con un default de 10
  /// no habia forma de decir que no hay descuento.
  kilosDescuento Int? @map("umbralMayorista")

  /// Si el formato caja/bin se muestra en el detalle del producto. Va aparte
  /// del precio a proposito: apagar el formato no borra lo que costaba, asi
  /// que volver a prenderlo no obliga a escribir el precio de nuevo.
  mostrarCaja Boolean @default(false)
  mostrarBin  Boolean @default(false)

  imagenTextura String @default("") @db.VarChar(500)
  imagenRecorte String @default("") @db.VarChar(500)
  colorAcento   String @default("#30CFB2")

  activo    Boolean @default(true)
  destacado Boolean @default(false)
  orden     Int     @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model Usuario {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Nombre de usuario, para entrar sin escribir el correo. Nullable a
  /// proposito: las cuentas que existian antes de este campo siguen entrando
  /// por correo, y MySQL admite varios NULL bajo un mismo indice unico. El
  /// cotejo de la base es utf8mb4_unicode_ci, asi que "doncarlos" y
  /// "DonCarlos" son el mismo usuario al buscar y al comprobar duplicados.
  usuario      String?   @unique
  nombre       String    @default("")
  hashClave    String
  rol          String    @default("admin") // admin | editor
  creadoEn     DateTime  @default(now())
  ultimoAcceso DateTime?
}

/// Correos autorizados a crearse una cuenta en /admin/registro.
model CorreoAutorizado {
  id          String    @id @default(cuid())
  email       String    @unique
  nota        String    @default("")
  usado       Boolean   @default(false)
  invitadoPor String    @default("")
  creadoEn    DateTime  @default(now())
  usadoEn     DateTime?
}

model Mensaje {
  id       String   @id @default(cuid())
  nombre   String
  email    String   @default("")
  telefono String   @default("")
  asunto   String   @default("Consulta")
  mensaje  String   @db.VarChar(1200)
  origen   String   @default("formulario") // formulario | whatsapp
  /// Número de WhatsApp que recibió el mensaje, cuando el reparto tiene
  /// varios. Vacío para los mensajes del formulario.
  destino  String   @default("")
  leido    Boolean  @default(false)
  /// "Leído" es automático al abrirlo; "respondido" lo marca la persona a
  /// mano, y es lo que sirve para saber qué queda pendiente de contestar.
  respondido   Boolean   @default(false)
  respondidoEn DateTime?
  creadoEn DateTime @default(now())
}

/// Fila única (id = "sitio") con los textos y datos editables del sitio.
model Ajustes {
  id            String   @id @default("sitio")
  nombreNegocio String   @default("La bodega de la economía")
  eslogan       String   @default("Un emprendimiento local para locales, donde el precio está al alcance de su bolsillo. Visítenos y consulte por nuestros productos cuando quiera.") @db.VarChar(400)
  direccion     String   @default("Malleco #04, Cooperativa La Cruz") @db.VarChar(255)
  ciudad        String   @default("Rancagua")
  telefono1     String   @default("+56995415039")
  telefono2     String   @default("+56941877683")
  whatsapp      String   @default("+56995415039")
  /// Reparto de la burbuja: JSON [{ nombre, numero, peso }]. Si está vacío se
  /// usa `whatsapp` como único destino. Los pesos son relativos entre sí.
  numerosWhatsapp String @default("[]") @db.VarChar(2000)
  /// Los tres sellos bajo los botones de la portada. JSON de strings; vacío
  /// o roto cae a los de fábrica para que la portada nunca quede pelada.
  portadaSellos String @default("[]") @db.VarChar(400)
  /// Títulos de la sección de productos, donde se explica que todo es al por
  /// mayor. Se editan desde el panel porque son el texto que más se ajusta.
  catalogoTitulo String @default("Siempre precio por mayor")
  catalogoBajada String @default("Acá no vendemos al detalle, todo es al por mayor. Consulte por los mejores productos de la región y lleve calidad hasta su negocio.") @db.VarChar(400)
  horario       String   @default("Lunes a viernes de 9:00 a 20:00, sábado de 9:00 a 15:00")
  descripcion   String   @default("Traemos la fruta directo del productor y la dejamos al precio más conveniente de Rancagua. Vendemos solo al por mayor, en cajas, bins o por kilo, para ferias, almacenes, restaurantes y locales comerciales.") @db.VarChar(700)
  mapaUrl       String   @default("") @db.VarChar(600)
  galeria       String   @default("[]") @db.VarChar(3000) // JSON array de rutas de imagen
  /// Piso del pedido, en kilos. La bodega vende solo al por mayor y ese piso
  /// se mueve segun la temporada, asi que se edita desde el panel en vez de
  /// estar clavado en el codigo. Siempre en kg: no hay otra unidad de venta.
  pedidoMinimoKg Int     @default(100)
  actualizadoEn DateTime @updatedAt
}
