{
  "name": "la-bodega-de-la-economia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:hosting": "TOKIO_WORKER_THREADS=2 UV_THREADPOOL_SIZE=2 VIPS_CONCURRENCY=1 next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "imagenes": "python scripts/preparar-imagenes.py",
    "logo": "python scripts/preparar-logo.py",
    "galeria": "python scripts/preparar-galeria.py && tsx --env-file=.env scripts/galeria-carrusel.ts",
    "limpiar": "tsx --env-file=.env scripts/limpiar-datos.ts",
    "exportar": "tsx --env-file=.env scripts/exportar-datos.ts",
    "importar": "tsx --env-file=.env scripts/importar-datos.ts",
    "usuario": "tsx --env-file=.env scripts/crear-usuario.ts",
    "formatos": "tsx --env-file=.env scripts/marcar-formatos.ts",
    "textos": "tsx --env-file=.env scripts/actualizar-textos.ts",
    "generate": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.4",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
