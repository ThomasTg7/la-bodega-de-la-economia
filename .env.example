# Postgres. En Vercel la inyecta sola la base de datos que conectes al
# proyecto (Storage -> Neon). En local, levanta un Postgres y apunta acá.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/bodega"
SESION_SECRETO="generar-con-openssl-rand-base64-32"
ADMIN_EMAIL_INICIAL="tu-correo@ejemplo.com"
ADMIN_PASS_INICIAL="una-clave-temporal-segura"
# Fotos que sube el panel. En Vercel la inyecta sola la store de Blob; en
# local se saca con `vercel env pull` o desde Storage -> tu store -> .env.local
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
