# Motor de la base: "postgresql" (por defecto) o "mariadb" / "mysql".
# Decide contra que schema de Prisma se genera el cliente en el postinstall,
# asi que en un hosting con MariaDB hay que declararlo ANTES del npm install.
# Ver DESPLIEGUE.md -> "Elegir el motor de base de datos".
DB_PROVIDER="postgresql"

# La base. El formato depende de DB_PROVIDER:
#
#   postgresql -> postgresql://usuario:clave@host.neon.tech/bodega?sslmode=require
#   mariadb    -> mysql://usuario:clave@127.0.0.1:3306/bodega
#
# En Vercel la inyecta sola la base que conectes al proyecto (Storage -> Neon).
# Para MariaDB, el prefijo va siempre "mysql://" aunque el motor sea MariaDB:
# hablan el mismo protocolo y el conector de Prisma es el mismo.
DATABASE_URL="postgresql://usuario:clave@host.neon.tech/bodega?sslmode=require"

# Firma las cookies del panel. Uno distinto por entorno, y nunca el de local en
# producción: con este valor cualquiera se fabrica una sesión de admin.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESION_SECRETO="generar-con-el-comando-de-arriba"

# Solo las lee prisma/seed.ts para crear la primera cuenta. Si en vez de sembrar
# migras los datos de local (npm run migrar), estas dos no hacen nada.
ADMIN_EMAIL_INICIAL="tu-correo@ejemplo.com"
ADMIN_PASS_INICIAL="una-clave-temporal-segura"

# Fotos que sube el panel. En Vercel la inyecta sola la store de Blob; en local
# se saca con `npx vercel env pull .env.local`. Sin esto, /api/upload falla.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Dominio real del sitio, sin barra final. La usan el canonical, OpenGraph,
# el sitemap y robots.txt para saber que URL anunciar. Sin esta variable cae
# a "https://labodegadelaeconomia.cl" (ver src/lib/sitio.ts) — solo hace
# falta declararla en un preview o un staging con otro dominio.
NEXT_PUBLIC_SITIO_URL="https://labodegadelaeconomia.cl"
