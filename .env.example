# La base es MariaDB. El prefijo va siempre "mysql://" aunque el motor sea
# MariaDB: hablan el mismo protocolo y el conector de Prisma es el mismo.
#
# En el hosting la base se crea desde cPanel -> MySQL Databases, y el host es
# 127.0.0.1 porque la app corre en la misma máquina que el motor.
# Ver DESPLIEGUE.md.
DATABASE_URL="mysql://usuario:clave@127.0.0.1:3306/bodega"

# Firma las cookies del panel. Uno distinto por entorno, y nunca el de local en
# producción: con este valor cualquiera se fabrica una sesión de admin.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESION_SECRETO="generar-con-el-comando-de-arriba"

# Solo las lee prisma/seed.ts para crear la primera cuenta. Si en vez de sembrar
# importas los datos que ya tenías (npm run importar), estas dos no hacen nada.
ADMIN_EMAIL_INICIAL="tu-correo@ejemplo.com"
ADMIN_PASS_INICIAL="una-clave-temporal-segura"

# Dominio real del sitio, sin barra final. La usan el canonical, OpenGraph,
# el sitemap y robots.txt para saber que URL anunciar. Sin esta variable cae
# a "https://labodegadelaeconomia.cl" (ver src/lib/sitio.ts) — solo hace
# falta declararla en un preview o un staging con otro dominio.
NEXT_PUBLIC_SITIO_URL="https://labodegadelaeconomia.cl"
